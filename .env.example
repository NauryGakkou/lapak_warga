# Konfigurasi Environment Lapak Warga

# Keamanan (Generate secret key unik untuk production)
SECRET_KEY=ganti-dengan-secret-key-acak-panjang-untuk-production
DEBUG=False

# Database untuk Vercel / Cloud Deployment (Sangat disarankan memakai PostgreSQL seperti Supabase / Neon / Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Opsi database lokal (MySQL atau SQLite)
DB_ENGINE=sqlite
DB_NAME=lapak_warga
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Host & Origin
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
